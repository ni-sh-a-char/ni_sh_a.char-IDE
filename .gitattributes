# Normalise to LF in the repository; check out native on Windows.
* text=auto eol=lf

# These must stay LF even on Windows checkouts -- they run on Linux.
*.sh          text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# Generated or vendored: keep out of diffs and language stats.
packages/web/package-lock.json  linguist-generated=true -diff
packages/web/dist/**            linguist-generated=true
languages/*.json                linguist-detectable=false

*.png binary
*.jpg binary
*.gif binary
*.ico binary
