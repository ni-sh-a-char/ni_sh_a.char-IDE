<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.ni-sh-a-char</groupId>
  <artifactId>nishachar-ide</artifactId>
  <version>2.0.0</version>
  <packaging>jar</packaging>

  <name>ni_sh_a.char-IDE</name>
  <description>
    Run any language, anywhere. A Kotlin and Java client for the ni_sh_a.char-IDE
    polyglot execution engine, with the full 62-language registry built in and
    zero runtime dependencies.
  </description>
  <url>https://ni-sh-a-char.github.io/ni_sh_a.char-IDE/</url>
  <inceptionYear>2022</inceptionYear>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>PIYUSH-MISHRA-00</id>
      <name>Piyush Mishra</name>
      <email>piyushmishra.professional@gmail.com</email>
      <url>https://github.com/PIYUSH-MISHRA-00</url>
      <organization>ni_sh_a.char</organization>
      <organizationUrl>https://github.com/ni-sh-a-char</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/ni-sh-a-char/ni_sh_a.char-IDE.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ni-sh-a-char/ni_sh_a.char-IDE.git</developerConnection>
    <url>https://github.com/ni-sh-a-char/ni_sh_a.char-IDE</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/ni-sh-a-char/ni_sh_a.char-IDE/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <kotlin.version>2.0.21</kotlin.version>
    <kotlin.compiler.jvmTarget>11</kotlin.compiler.jvmTarget>
    <!-- Consumers get no transitive dependencies at all. See Json.kt. -->
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>

    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-test-junit5</artifactId>
      <version>${kotlin.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <testSourceDirectory>src/test/kotlin</testSourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals><goal>compile</goal></goals>
            <configuration>
              <args>
                <!-- Every public declaration must state its visibility and an
                     explicit type. This is a published API, so the compiler
                     enforces it. Scoped to main only: tests are not API, and
                     applying it there would just add noise. -->
                <arg>-Xexplicit-api=strict</arg>
              </args>
            </configuration>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>test-compile</phase>
            <goals><goal>test-compile</goal></goals>
          </execution>
        </executions>
        <configuration>
          <jvmTarget>11</jvmTarget>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Maven Central requires a javadoc jar. Dokka produces real Kotlin
           docs; this keeps the requirement satisfied without a second toolchain. -->
      <plugin>
        <groupId>org.jetbrains.dokka</groupId>
        <artifactId>dokka-maven-plugin</artifactId>
        <version>1.9.20</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <phase>package</phase>
            <goals><goal>javadocJar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Signing and deployment only happen when explicitly requested, so a
         plain `mvn verify` needs no GPG key. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <!-- Wait only for validation, not for the artifact to appear in
                   the index. 'published' blocks for ~13 minutes and then the
                   client has to parse a status response it may not recognise;
                   0.7.0 crashed on an unknown "warnings" field *after* the
                   deploy had already succeeded, turning a good release red. -->
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
