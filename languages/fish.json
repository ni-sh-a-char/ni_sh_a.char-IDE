{
  "$schema": "./schema.json",
  "id": "fish",
  "name": "Fish",
  "aliases": [],
  "extensions": [
    ".fish"
  ],
  "comment": "#",
  "highlight": "shell",
  "image": "alpine:latest",
  "setup": [
    [
      "apk",
      "add",
      "--no-cache",
      "fish"
    ]
