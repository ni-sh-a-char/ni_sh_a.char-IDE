{
  "$schema": "./schema.json",
  "id": "elm",
  "name": "Elm",
  "aliases": [],
  "extensions": [
    ".elm"
  ],
  "comment": "--",
  "highlight": "elm",
  "image": "node:22-alpine",
  "setup": [
    [
      "npm",
      "i",
      "-g",
      "elm"
    ]
  ],
  "run": [
    "elm",
    "make",
    "{file}"
  ],
  "template": "module Main exposing (main)\n\nimport Html exposing (text)\n\nmain =\n    text \"Hello from Elm!\"\n",
  "website": "https://elm-lang.org"
}
